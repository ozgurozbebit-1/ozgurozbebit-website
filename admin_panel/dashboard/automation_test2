function extractPlatformText(platform){
    function cleanPlatformText(text){
        return text
            .replace(/^Başlık\s*:\s*.*(\r?\n)+/i, "")
            .replace(/^Baslik\s*:\s*.*(\r?\n)+/i, "")
            .trim();
    }
    const content = document.getElementById("contentResult").innerText || "";
    const social = document.getElementById("socialResult").innerText || "";
    const topic = document.getElementById("autoTopic").value.trim();

    if(platform === "linkedin"){
    const match = content.match(/5\.\s*LINKEDIN YAZISI([\s\S]*?)(\n\s*\d+\.\s|$)/i);
    if(match && match[1].trim() !== ""){
        return cleanPlatformText(match[1].trim());
    }
}

if(platform === "instagram"){
    const match = content.match(/1\.\s*INSTAGRAM POSTU([\s\S]*?)(\n\s*2\.\s|$)/i);
    if(match && match[1].trim() !== ""){
        return cleanPlatformText(match[1].trim());
    }
}

    if(platform === "facebook"){
        const match = content.match(/1\.\s*INSTAGRAM POSTU([\s\S]*?)(\n\s*2\.\s|$)/i);
        if(match && match[1].trim() !== ""){
            return cleanPlatformText(match[1].trim());
        }
    }

    if(
        social.trim() !== "" &&
        !social.includes("Sosyal medya metni burada") &&
        !social.includes("hazırlanıyor") &&
        !social.includes("üretilemedi") &&
        !social.includes("Bağlantı hatası")
    ){
        return cleanPlatformText(social.trim());
    }

    return topic;
}

